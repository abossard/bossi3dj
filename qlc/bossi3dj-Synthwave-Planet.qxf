<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>bossi3dj osc/qlc_fixture.py</Name>
  <Version>1</Version>
  <Author>bossi3dj</Author>
 </Creator>
 <Manufacturer>bossi3dj</Manufacturer>
 <Model>Synthwave Planet</Model>
 <Type>Other</Type>
 <Channel Name="/vj/level" Default="128">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">The sun and its glow get stronger the louder the music is.</Capability>
 </Channel>
 <Channel Name="/vj/bass" Default="0">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Bass makes things hit harder: the glowing ground net and waterline in Blender, the shake and dust of each footfall in Godot.</Capability>
 </Channel>
 <Channel Name="/vj/beat" Default="0">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Pulses on every beat: pyramid edges, stars and water glints in Blender, footfalls and dust puffs in Godot.</Capability>
 </Channel>
 <Channel Name="/vj/hue" Default="0">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="255">Turns all colours around the colour wheel.</Capability>
 </Channel>
 <Channel Name="/vj/intensity" Default="128">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Makes the whole picture brighter or darker.</Capability>
 </Channel>
 <Channel Name="/vj/strobe" Default="0">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Flashes the picture to white; higher means a stronger flash.</Capability>
 </Channel>
 <Channel Name="/vj/grid_speed" Default="38">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the glowing grid on the ground scroll faster.</Capability>
 </Channel>
 <Channel Name="/vj/cam" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="21">0 Plaza View</Capability>
  <Capability Min="22" Max="42">1 River Skim</Capability>
  <Capability Min="43" Max="63">2 Pyramid Hero</Capability>
  <Capability Min="64" Max="85">3 Moon Watch</Capability>
  <Capability Min="86" Max="106">4 Pole Flyover</Capability>
  <Capability Min="107" Max="127">5 Pyramid Orbit</Capability>
  <Capability Min="128" Max="149">6 Planet Orbit</Capability>
  <Capability Min="150" Max="170">7 Flamingo Lake</Capability>
  <Capability Min="171" Max="191">8 River Mouth</Capability>
  <Capability Min="192" Max="213">9 Far Pyramids</Capability>
  <Capability Min="214" Max="234">10 Coast Pass</Capability>
  <Capability Min="235" Max="255">11 Flight</Capability>
 </Channel>
 <Channel Name="/vj/cam_speed" Default="64">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the camera drift and fly faster or slower.</Capability>
 </Channel>
 <Channel Name="/vj/sun" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Lifts the sun up the sky and makes it bigger; 0 sinks it below the horizon.</Capability>
 </Channel>
 <Channel Name="/vj/moon" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the moon bigger or smaller.</Capability>
 </Channel>
 <Channel Name="/vj/moon_phase" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Changes the shape of the moon from new through half to full.</Capability>
 </Channel>
 <Channel Name="/vj/pyramids" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the pyramids rise out of the ground.</Capability>
 </Channel>
 <Channel Name="/vj/grid" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Shows the real triangle edges of the ground as a glowing net at night; by day there is none.</Capability>
 </Channel>
 <Channel Name="/vj/stars" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Fades the stars in or out.</Capability>
 </Channel>
 <Channel Name="/vj/water" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Turns the reflections on the water up or down.</Capability>
 </Channel>
 <Channel Name="/vj/night" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Turns day into night: 0 is day, a quarter is sunset, half is twilight, 1 is night.</Capability>
 </Channel>
 <Channel Name="/vj/nebula" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Fades in the coloured cloud in the night sky.</Capability>
 </Channel>
 <Channel Name="/vj/shock" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="127">off</Capability>
  <Capability Min="128" Max="255">fire once, harder the higher: A shock wave runs over the land once; in Godot the giant shakes while the Wanderer is on it.</Capability>
 </Channel>
 <Channel Name="/vj/meteor" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="127">off</Capability>
  <Capability Min="128" Max="255">fire once, harder the higher: A shooting star crosses the sky.</Capability>
 </Channel>
 <Channel Name="/vj/flamingos" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the flock of flamingos bigger; 0 hides it.</Capability>
 </Channel>
 <Channel Name="/vj/fog" Default="89">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">More fog near the ground; at 1 it is dense autumn fog.</Capability>
 </Channel>
 <Channel Name="/vj/fog_height" Default="105">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the fog bank taller or lower.</Capability>
 </Channel>
 <Channel Name="/vj/fog_glow" Default="76">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the fog glow by itself.</Capability>
 </Channel>
 <Channel Name="/vj/fog_hue" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Tints the fog pink, violet or cyan.</Capability>
 </Channel>
 <Channel Name="/vj/fog_noise" Default="153">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the fog patchier.</Capability>
 </Channel>
 <Channel Name="/vj/fog_scale" Default="64">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the fog clouds bigger or smaller.</Capability>
 </Channel>
 <Channel Name="/vj/fog_speed" Default="64">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the wind push the fog along faster.</Capability>
 </Channel>
 <Channel Name="/vj/fog_beat" Default="128">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the fog pump with the beat.</Capability>
 </Channel>
 <Channel Name="/vj/haze" Default="255">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Adds or removes the soft haze toward the horizon.</Capability>
 </Channel>
 <Channel Name="/vj/eclipse" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Lines the moon up with the sun and the planet for an eclipse.</Capability>
 </Channel>
 <Channel Name="/vj/star_speed" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the stars drift across the sky.</Capability>
 </Channel>
 <Channel Name="/vj/flight" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Steers the flying camera: 0 high orbit, then a landing approach, a skim over the mountains, and at 1 a hover over the water.</Capability>
 </Channel>
 <Channel Name="/vj/boost" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Gives the flying camera a burst of speed with a wider view.</Capability>
 </Channel>
 <Channel Name="/vj/blend" Default="128">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes a camera change fly smoothly to the new shot; 0 cuts at once.</Capability>
 </Channel>
 <Channel Name="/vj/energy" Default="76">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Makes the camera move harder, from a slow wide glide to faster, tighter moves.</Capability>
 </Channel>
 <Channel Name="/vj/hit" Default="0">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="127">off</Capability>
  <Capability Min="128" Max="255">fire once, harder the higher: A quick surge of speed with a wide-angle kick on the camera.</Capability>
 </Channel>
 <Mode Name="Synthwave">
  <Channel Number="0">/vj/level</Channel>
