  <Channel Number="24">/vj/fog_hue</Channel>
  <Channel Number="25">/vj/fog_noise</Channel>
  <Channel Number="26">/vj/fog_scale</Channel>
  <Channel Number="27">/vj/fog_speed</Channel>
  <Channel Number="28">/vj/fog_beat</Channel>
